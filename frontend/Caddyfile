# Production web server: serves the built app and forwards the API.
# SITE_ADDRESS ":80" serves plain HTTP on the server's IP; a domain name
# (e.g. "grit.example.com") makes Caddy fetch an HTTPS certificate automatically.
{$SITE_ADDRESS::80} {
	encode zstd gzip

	@api path /api/* /docs /docs/* /openapi.json
	handle @api {
		reverse_proxy api:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@media path /videos/* /shots/*
	header @media Cache-Control "public, max-age=86400"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		-Server
	}
}
